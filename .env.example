# API settings
DEBUG=False
ROOT_PATH=/core/api/windninja
DOCS_URL=/api-docs
CORS_ALLOW_ORIGINS=http://localhost,http://

# MinIO settings
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=your_access_key
MINIO_SECRET_KEY=your_secret_key
MINIO_USE_SSL=False
MINIO_BUCKET=cu68
MINIO_FORECAST_BUCKET=forecast-data

# FEWS MinIO settings (used only when request has "fews": true)
# If FEWS_MINIO_ENDPOINT is empty, the service falls back to MINIO_ENDPOINT.
# Note: FEWS_* variables are applied only when the request body includes "fews": true.
FEWS_MINIO_ENDPOINT=
FEWS_MINIO_ACCESS_KEY=your_fews_access_key
FEWS_MINIO_SECRET_KEY=your_fews_secret_key
FEWS_MINIO_USE_SSL=False
FEWS_MINIO_BUCKET=your_fews_bucket
FEWS_MINIO_FORECAST_BUCKET=your_fews_forecast_bucket

# Kafka settings
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=windninja-results
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_USERNAME=your_kafka_username
KAFKA_PASSWORD=your_kafka_password
KAFKA_SESSION_TIMEOUT_MS=6000
KAFKA_REQUEST_TIMEOUT_MS=10000
KAFKA_GROUP_ID=GROUP_DXC_PROC_EXEC

# FEWS Kafka settings (used only when request has "fews": true)
# If FEWS_KAFKA_BOOTSTRAP_SERVERS is empty, the service falls back to KAFKA_BOOTSTRAP_SERVERS.
# Note: FEWS_* variables are applied only when the request body includes "fews": true.
FEWS_KAFKA_BOOTSTRAP_SERVERS=
FEWS_KAFKA_SECURITY_PROTOCOL=SASL_SSL
FEWS_KAFKA_SASL_MECHANISM=SCRAM-SHA-512
FEWS_KAFKA_USERNAME=your_fews_kafka_username
FEWS_KAFKA_PASSWORD=your_fews_kafka_password
FEWS_KAFKA_REQUEST_TIMEOUT_MS=10000
# Topic for FEWS result notifications
FEWS_KAFKA_TOPIC_RESULTS=fews-windninja-results

# Logging settings
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_FILE=/app/logs/windninja.log
LOG_BACKUP_COUNT=5
LOG_MAX_BYTES=10485760

# Log read/download settings
LOG_TAIL_DEFAULT_LINES=50